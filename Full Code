@dataclass
class TradeResult:
    name: str
    option_type: str
    price: float
    std_error: float
    notional: float
    maturity: float
    mc_result: MCResult


class Portfolio:
    def __init__(self):
        self.trades: List[TradeResult] = []

    def add_trade(self, name, option_type, price, std_error, notional, maturity, mc_result):
        self.trades.append(TradeResult(name, option_type, price, std_error, notional, maturity, mc_result))

    @property
    def total_value(self):
        return sum(t.price for t in self.trades)

    def summary_table(self):
        rows = [{"Trade": t.name, "Type": t.option_type, "Notional (EUR)": t.notional,
                 "Maturity (yrs)": t.maturity, "Price (EUR)": t.price,
                 "MC std error": t.std_error, "Price as % notional": 100 * t.price / t.notional}
                for t in self.trades]
        df = pd.DataFrame(rows)
        total_row = {"Trade": "TOTAL PORTFOLIO", "Type": "-",
                     "Notional (EUR)": df["Notional (EUR)"].sum(), "Maturity (yrs)": np.nan,
                     "Price (EUR)": df["Price (EUR)"].sum(),
                     "MC std error": np.sqrt((df["MC std error"]**2).sum()), "Price as % notional": np.nan}
        return pd.concat([df, pd.DataFrame([total_row])], ignore_index=True)

    def simulated_portfolio_payoffs(self):
        n = min(len(t.mc_result.payoffs) for t in self.trades)
        rng = np.random.default_rng(123)
        total = np.zeros(n)
        for t in self.trades:
            disc_payoffs = t.mc_result.payoffs * t.mc_result.discount_factor * t.notional
            total += rng.choice(disc_payoffs, size=n, replace=True)
        return total

    def value_at_risk(self, confidence=0.95):
        pnl = self.simulated_portfolio_payoffs() - self.total_value
        return -np.percentile(pnl, 100 * (1 - confidence))


