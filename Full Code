def plot_basket_vs_benchmark(basket_series, bench_series, basket_label, bench_label, rho, beta, filename):
    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    b_norm = 100 * basket_series / basket_series.iloc[0]
    bm_norm = 100 * bench_series / bench_series.iloc[0]
    axes[0].plot(b_norm.index, b_norm, label=basket_label, color=PALETTE["cac"], linewidth=1.6)
    axes[0].plot(bm_norm.index, bm_norm, label=bench_label, color=PALETTE["sp"], linewidth=1.6)
    axes[0].set_title("Cumulative performance (base 100)")
    axes[0].legend(fontsize=9)

    ret_basket = np.log(basket_series / basket_series.shift(1)).dropna()
    ret_bench = np.log(bench_series / bench_series.shift(1)).dropna()
    common = pd.concat([ret_basket, ret_bench], axis=1).dropna()
    axes[1].scatter(common.iloc[:, 1] * 100, common.iloc[:, 0] * 100, s=8, alpha=0.35, color=PALETTE["accent3"])
    xline = np.linspace(common.iloc[:, 1].min(), common.iloc[:, 1].max(), 50)
    axes[1].plot(xline * 100, beta * xline * 100, color="black", linewidth=1.5, label=f"beta = {beta:.2f}")
    axes[1].set_xlabel(f"Daily return {bench_label} (%)")
    axes[1].set_ylabel(f"Daily return {basket_label} (%)")
    axes[1].set_title(f"Correlation = {rho:.2f}")
    axes[1].legend(fontsize=9)
    fig.suptitle(f"{basket_label}  vs  {bench_label}", fontweight="bold")
    return _save(fig, filename)


