def plot_mc_convergence(payoffs, discount, notional, trade_name, filename):
    disc_payoffs = payoffs * discount * notional
    running_mean = np.cumsum(disc_payoffs) / np.arange(1, len(disc_payoffs) + 1)
    running_std = np.array([disc_payoffs[:i].std(ddof=1) / np.sqrt(i) if i > 1 else np.nan
                             for i in range(1, len(disc_payoffs) + 1)])
    step = max(len(disc_payoffs) // 2000, 1)
    x = np.arange(1, len(disc_payoffs) + 1)[::step]
    m, se = running_mean[::step], running_std[::step]

    fig, ax = plt.subplots(figsize=(11, 6))
    ax.plot(x, m / 1000, color=PALETTE["cac"], linewidth=1.8, label="Estimated price (running mean)")
    ax.fill_between(x, (m - 1.96 * se) / 1000, (m + 1.96 * se) / 1000, color=PALETTE["cac"],
                     alpha=0.2, label="95% CI")
    ax.set_xlabel("Number of simulated paths")
    ax.set_ylabel("Price (k EUR)")
    ax.set_title(f"Monte Carlo convergence\n{trade_name}")
    ax.legend()
    return _save(fig, filename)


