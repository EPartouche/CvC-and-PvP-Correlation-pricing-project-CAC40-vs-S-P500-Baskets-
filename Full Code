# ==============================================================================
# 1. MARKET DATA SIMULATION (fallback when Yahoo Finance is unavailable)
# ==============================================================================
#
# Model (daily log returns):  r_i,t = beta_mkt_i * F_mkt,t + beta_sector_i * F_sector,t + eps_i,t
# This 3-factor model (local market + common sector + idiosyncratic) lets us
# CALIBRATE explicit, realistic correlations between CAC40 baskets, S&P500
# baskets, and sector benchmark indices.

def _generate_factors(n_days, rng):
    dt = 1 / 252
    corr_cac_sp = 0.55
    corr_mkt_sector = 0.35
    cov = np.array([[1.00, corr_cac_sp, corr_mkt_sector],
                     [corr_cac_sp, 1.00, corr_mkt_sector],
                     [corr_mkt_sector, corr_mkt_sector, 1.00]])
    L = np.linalg.cholesky(cov)
    z = rng.standard_normal((n_days, 3))
    correlated = z @ L.T
    sigma_mkt_cac, sigma_mkt_sp, sigma_sector = 0.17, 0.16, 0.20
    F_cac = correlated[:, 0] * sigma_mkt_cac * np.sqrt(dt)
    F_sp = correlated[:, 1] * sigma_mkt_sp * np.sqrt(dt)
    F_sector = correlated[:, 2] * sigma_sector * np.sqrt(dt)
    return F_cac, F_sp, F_sector


def simulate_market(all_tickers_meta, n_days=N_DAYS, seed=SEED, start_price=100.0):
    rng = np.random.default_rng(seed)
    dt = 1 / 252
    F_cac, F_sp, F_sector = _generate_factors(n_days, rng)
    dates = pd.bdate_range(end=pd.Timestamp.today().normalize(), periods=n_days)
    prices = {}
    for meta in all_tickers_meta:
        ticker = meta["ticker"]
        beta_mkt, beta_sec, idio_vol = meta["market_beta"], meta["sector_beta"], meta["idio_vol"]
        mkt_factor = F_cac if meta["market"] == "CAC" else F_sp
        mu = 0.06 if meta["market"] != "BENCH" else 0.05
        eps = rng.standard_normal(n_days)
        idio = idio_vol * np.sqrt(dt) * eps
        drift = (mu - 0.5 * (beta_mkt**2 * 0.17**2 + beta_sec**2 * 0.20**2 + idio_vol**2)) * dt
        log_ret = drift + beta_mkt * mkt_factor + beta_sec * F_sector + idio
        prices[ticker] = start_price * np.exp(np.cumsum(log_ret))
    return pd.DataFrame(prices, index=dates)


def build_meta_from_baskets(baskets, benchmarks):
    meta, seen = [], set()
    for b in baskets:
        market_tag = "CAC" if b.currency == "EUR" else "SP"
        for t in b.tickers:
            if t in seen:
                continue
            seen.add(t)
            meta.append({"ticker": t, "market": market_tag, "market_beta": b.market_beta,
                         "sector_beta": b.sector_beta, "idio_vol": b.idio_vol})
    for name, params in benchmarks.items():
        meta.append({"ticker": name, "market": "BENCH", "market_beta": params["market_beta"],
                     "sector_beta": params["sector_beta"], "idio_vol": params["idio_vol"]})
    return meta


