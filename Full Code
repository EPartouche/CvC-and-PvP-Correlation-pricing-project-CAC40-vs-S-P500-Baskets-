# 5. CORRELATION ANALYSIS
# ==============================================================================

def full_correlation_matrix(basket_returns, bench_returns):
    return pd.concat([basket_returns, bench_returns], axis=1).dropna().corr()


def rolling_pair_correlation(ret_A, ret_B, window=60):
    return ret_A.rolling(window).corr(ret_B)


def rolling_correlations_all_trades(basket_returns, trades, window=60):
    out = {}
    for trade in trades:
        out[trade["name"]] = rolling_pair_correlation(
            basket_returns[trade["basket_A"].name], basket_returns[trade["basket_B"].name], window)
    return pd.DataFrame(out)


def basket_vs_benchmark_correlation(basket_returns, bench_returns, basket_to_bench, window=60):
    out = {}
    for basket_name, bench_name in basket_to_bench.items():
        if basket_name in basket_returns.columns and bench_name in bench_returns.columns:
            label = f"{basket_name.split(' (')[0]} vs {bench_name}"
            out[label] = rolling_pair_correlation(basket_returns[basket_name], bench_returns[bench_name], window)
    return pd.DataFrame(out)


def static_basket_vs_benchmark(basket_returns, bench_returns, basket_to_bench):
    rows = []
    for basket_name, bench_name in basket_to_bench.items():
        if basket_name in basket_returns.columns and bench_name in bench_returns.columns:
            combined = pd.concat([basket_returns[basket_name], bench_returns[bench_name]], axis=1).dropna()
            rho = combined.corr().iloc[0, 1]
            beta = np.polyfit(combined.iloc[:, 1], combined.iloc[:, 0], 1)[0]
            rows.append({"Basket": basket_name, "Benchmark": bench_name,
                         "Correlation": rho, "Beta (basket / benchmark)": beta})
    return pd.DataFrame(rows)


