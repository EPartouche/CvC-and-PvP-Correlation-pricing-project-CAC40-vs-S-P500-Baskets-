def _try_yfinance(tickers, n_days):
    try:
        import yfinance as yf
        period_days = int(n_days * 1.55)
        data = yf.download(tickers, period=f"{period_days}d", interval="1d",
                            progress=False, auto_adjust=True, threads=True)
        if data.empty:
            return None
        if isinstance(data.columns, pd.MultiIndex):
            close = data["Close"]
        else:
            close = data[["Close"]]
            close.columns = tickers
        close = close.dropna(how="all").ffill().dropna()
        if close.shape[0] < 250 or close.isna().any().any():
            return None
        return close.tail(n_days)
    except Exception:
        return None


def load_all_data(n_days=N_DAYS, seed=SEED, force_simulation=False):
    all_stock_tickers = sorted({t for b in ALL_BASKETS for t in b.tickers})
    prices_real, source = None, "simulation"
    if not force_simulation:
        prices_real = _try_yfinance(all_stock_tickers, n_days)
        if prices_real is not None:
            source = "yfinance"

    meta_all = build_meta_from_baskets(ALL_BASKETS, SECTOR_BENCHMARKS)
    meta_bench_only = [m for m in meta_all if m["market"] == "BENCH"]

    if prices_real is None:
        meta_stocks = [m for m in meta_all if m["market"] != "BENCH"]
        full_sim = simulate_market(meta_stocks + meta_bench_only, n_days=n_days, seed=seed)
        prices_real = full_sim[[m["ticker"] for m in meta_stocks]]
        prices_bench = full_sim[[m["ticker"] for m in meta_bench_only]]
    else:
        sim_bench = simulate_market(meta_bench_only, n_days=len(prices_real), seed=seed)
        sim_bench.index = prices_real.index
        prices_bench = sim_bench

    return prices_real, prices_bench, source


