def build_basket_index(basket: Basket, prices: pd.DataFrame, base_value=100.0) -> pd.Series:
    sub = prices[basket.tickers].copy()
    norm_prices = sub / sub.iloc[0]
    weighted = (norm_prices * np.array(basket.weights)).sum(axis=1)
    s = base_value * weighted
    s.name = basket.name
    return s


def build_all_baskets(baskets, prices) -> pd.DataFrame:
    return pd.DataFrame({b.name: build_basket_index(b, prices) for b in baskets})


def build_benchmark_indices(prices_bench, base_value=100.0) -> pd.DataFrame:
    return base_value * prices_bench / prices_bench.iloc[0]


def log_returns(price_df: pd.DataFrame) -> pd.DataFrame:
    return np.log(price_df / price_df.shift(1)).dropna()


# ==============================================================================
# 4. MONTE CARLO PRICING ENGINE -- CvC ("Call vs Call") & PvP ("Put vs Put")
# ==============================================================================
#
# Let R_A = S_A(T)/S_A(0) - 1  and  R_B = S_B(T)/S_B(0) - 1.
#   CvC payoff = N * max(R_A - R_B, 0)   -> long relative outperformance of A vs B
#   PvP payoff = N * max(R_B - R_A, 0)   -> hedge against relative underperformance of A vs B
# These are exchange options; a basket is a sum of lognormal assets and is
# therefore not itself lognormal -> priced by Monte Carlo (Margrabe formula
# given below as a closed-form 2-asset reference / sanity check).

@dataclass
class MCResult:
    price: float
    std_error: float
    ci_95: tuple
    paths_A: np.ndarray
    paths_B: np.ndarray
    payoffs: np.ndarray
    discount_factor: float


def _estimate_vols_and_corr(log_ret: pd.DataFrame):
    vols = log_ret.std() * np.sqrt(252)
    corr = log_ret.corr()
    return vols.values, corr.values


def price_exchange_option(basket_A_tickers, basket_B_tickers, weights_A, weights_B,
                           log_returns_all, option_type, T, r, notional=1_000_000, mc_params=None) -> MCResult:
    mc_params = mc_params or MC_PARAMS
    tickers = list(dict.fromkeys(basket_A_tickers + basket_B_tickers))
    vols, corr = _estimate_vols_and_corr(log_returns_all[tickers])

    idx = {t: i for i, t in enumerate(tickers)}
    w_full_A = np.zeros(len(tickers))
    w_full_B = np.zeros(len(tickers))
    for t, w in zip(basket_A_tickers, weights_A):
        w_full_A[idx[t]] = w
    for t, w in zip(basket_B_tickers, weights_B):
        w_full_B[idx[t]] = w

    n_steps = max(int(mc_params["n_steps_per_year"] * T), 4)
    n_assets = len(tickers)
    L = np.linalg.cholesky(corr + 1e-10 * np.eye(n_assets))
    rng = np.random.default_rng(mc_params["seed"])
    n_sim = mc_params["n_paths"] // 2 if mc_params["antithetic"] else mc_params["n_paths"]
    dt = T / n_steps

    log_paths = np.zeros((n_sim, n_assets))
    log_paths_anti = np.zeros((n_sim, n_assets))
    for _ in range(n_steps):
        z = rng.standard_normal((n_sim, n_assets))
        corr_z = z @ L.T
        drift = (r - 0.5 * vols**2) * dt
        diffusion = vols * np.sqrt(dt) * corr_z
        log_paths += drift + diffusion
        if mc_params["antithetic"]:
            log_paths_anti += drift + vols * np.sqrt(dt) * (-z @ L.T)

    all_log_paths = np.vstack([log_paths, log_paths_anti]) if mc_params["antithetic"] else log_paths
    ST_over_S0 = np.exp(all_log_paths)
    perf_A = ST_over_S0 @ w_full_A - 1.0
    perf_B = ST_over_S0 @ w_full_B - 1.0

    if option_type == "CvC":
        payoffs = np.maximum(perf_A - perf_B, 0.0)
    elif option_type == "PvP":
        payoffs = np.maximum(perf_B - perf_A, 0.0)
    else:
        raise ValueError("option_type must be 'CvC' or 'PvP'")

    discount = np.exp(-r * T)
    disc_payoffs = discount * payoffs * notional
    price = disc_payoffs.mean()
    se = disc_payoffs.std(ddof=1) / np.sqrt(len(disc_payoffs))
    ci = (price - 1.96 * se, price + 1.96 * se)

    return MCResult(price, se, ci, perf_A, perf_B, payoffs, discount)


def margrabe_price(S0_A, S0_B, sigma_A, sigma_B, rho, T, notional=1_000_000):
    """Closed-form Margrabe formula (2-asset case), used as a validation
    reference for the Monte Carlo engine."""
    sigma = np.sqrt(sigma_A**2 + sigma_B**2 - 2 * rho * sigma_A * sigma_B)
    d1 = (np.log(S0_A / S0_B) + 0.5 * sigma**2 * T) / (sigma * np.sqrt(T))
    d2 = d1 - sigma * np.sqrt(T)
    return (S0_A * norm.cdf(d1) - S0_B * norm.cdf(d2)) * notional


def correlation_sensitivity(basket_A_tickers, basket_B_tickers, weights_A, weights_B,
                             log_returns_all, option_type, T, r, notional,
                             rho_shocks=np.linspace(-0.3, 0.95, 14), mc_params=None):
    """Prices the CvC/PvP option for different IMPOSED inter-basket
    correlation levels -- gives the 'correlation vega' profile."""
    mc_params = mc_params or MC_PARAMS
    tickers = list(dict.fromkeys(basket_A_tickers + basket_B_tickers))
    vols, base_corr = _estimate_vols_and_corr(log_returns_all[tickers])
    idx = {t: i for i, t in enumerate(tickers)}
    w_full_A = np.zeros(len(tickers))
    w_full_B = np.zeros(len(tickers))
    for t, w in zip(basket_A_tickers, weights_A):
        w_full_A[idx[t]] = w
    for t, w in zip(basket_B_tickers, weights_B):
        w_full_B[idx[t]] = w

    results = []
    for target_rho in rho_shocks:
        n = len(tickers)
        corr_shocked = base_corr.copy()
        is_A = np.array([t in basket_A_tickers for t in tickers])
        is_B = np.array([t in basket_B_tickers for t in tickers])
        for i in range(n):
            for j in range(n):
                if is_A[i] and is_B[j] and i != j:
                    corr_shocked[i, j] = target_rho
                    corr_shocked[j, i] = target_rho
        eigval, eigvec = np.linalg.eigh(corr_shocked)
        eigval = np.clip(eigval, 1e-6, None)
        corr_shocked = eigvec @ np.diag(eigval) @ eigvec.T
        d = np.sqrt(np.diag(corr_shocked))
        corr_shocked = corr_shocked / np.outer(d, d)

        n_steps = max(int(mc_params["n_steps_per_year"] * T), 4)
        n_assets = len(tickers)
        L = np.linalg.cholesky(corr_shocked + 1e-10 * np.eye(n_assets))
        rng = np.random.default_rng(mc_params["seed"])
        n_sim = mc_params["n_paths"] // 4
        dt = T / n_steps

        log_paths = np.zeros((n_sim, n_assets))
        for _ in range(n_steps):
            z = rng.standard_normal((n_sim, n_assets))
            drift = (r - 0.5 * vols**2) * dt
            diffusion = vols * np.sqrt(dt) * (z @ L.T)
            log_paths += drift + diffusion

        ST_over_S0 = np.exp(log_paths)
        perf_A = ST_over_S0 @ w_full_A - 1.0
        perf_B = ST_over_S0 @ w_full_B - 1.0
        payoffs = (np.maximum(perf_A - perf_B, 0.0) if option_type == "CvC"
                   else np.maximum(perf_B - perf_A, 0.0))
        results.append(np.exp(-r * T) * payoffs.mean() * notional)

    return np.array(rho_shocks), np.array(results)


