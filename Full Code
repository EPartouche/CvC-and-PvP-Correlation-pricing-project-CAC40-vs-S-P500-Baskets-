    rolling_corr = rolling_correlations_all_trades(basket_rets, TRADES, window=60)
    plot_rolling_correlations(rolling_corr, "Rolling correlation (60d) -- CvC/PvP trading pairs",
                               "05_rolling_correlation_trades")

    section("4. MONTE CARLO PRICING OF CvC / PvP TRADES")
    portfolio = Portfolio()
    for i, trade in enumerate(TRADES, start=1):
        A, B = trade["basket_A"], trade["basket_B"]
        res_cvc = price_exchange_option(A.tickers, B.tickers, A.weights, B.weights,
                                         log_returns(prices_stocks), "CvC", trade["maturity_years"],
                                         RISK_FREE_EUR, trade["notional"], MC_PARAMS)
        res_pvp = price_exchange_option(A.tickers, B.tickers, A.weights, B.weights,
                                         log_returns(prices_stocks), "PvP", trade["maturity_years"],
                                         RISK_FREE_EUR, trade["notional"], MC_PARAMS)

        print(f"\n[{trade['name']}]  (maturity {trade['maturity_years']} yr(s), "
              f"notional {trade['notional']:,.0f} EUR)")
        print(f"   CvC (long outperf. {A.name.split(' (')[0]}) : price = {res_cvc.price:,.0f} EUR  "
              f"(95% CI [{res_cvc.ci_95[0]:,.0f} ; {res_cvc.ci_95[1]:,.0f}])")
        print(f"   PvP (underperf. hedge)                   : price = {res_pvp.price:,.0f} EUR  "
              f"(95% CI [{res_pvp.ci_95[0]:,.0f} ; {res_pvp.ci_95[1]:,.0f}])")

        portfolio.add_trade(f"{trade['name']} (CvC)", "CvC", res_cvc.price, res_cvc.std_error,
                             trade["notional"], trade["maturity_years"], res_cvc)

        tag = trade['name'][:20].replace(' ', '_')
        plot_payoff_scatter(res_cvc.paths_A, res_cvc.paths_B, "CvC", trade["name"], f"06_{i:02d}_payoff_{tag}")
        plot_mc_convergence(res_cvc.payoffs, res_cvc.discount_factor, trade["notional"],
                             trade["name"], f"07_{i:02d}_convergence_{tag}")

    section("5. CORRELATION SENSITIVITY (CORRELATION VEGA)")
    for i, trade in enumerate(TRADES, start=1):
        A, B = trade["basket_A"], trade["basket_B"]
        current_rho = corr_matrix.loc[A.name, B.name]
