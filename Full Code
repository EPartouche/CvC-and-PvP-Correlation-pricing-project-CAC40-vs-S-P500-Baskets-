def plot_payoff_scatter(perf_A, perf_B, option_type, trade_name, filename, sample_size=4000):
    rng = np.random.default_rng(7)
    idx = rng.choice(len(perf_A), size=min(sample_size, len(perf_A)), replace=False)
    x, y = perf_A[idx] * 100, perf_B[idx] * 100
    diff = (perf_A[idx] - perf_B[idx]) * 100

    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    ax = axes[0]
    mask = (diff > 0) if option_type == "CvC" else (diff < 0)
    ax.scatter(x[~mask], y[~mask], s=6, color=PALETTE["grey"], alpha=0.35, label="Out of the money")
    ax.scatter(x[mask], y[mask], s=6, color=PALETTE["accent2"], alpha=0.55, label="In the money")
    lims = [min(x.min(), y.min()), max(x.max(), y.max())]
    ax.plot(lims, lims, color="black", linewidth=1, linestyle="--", label="R_A = R_B")
    ax.set_xlabel("Basket A performance (%)")
    ax.set_ylabel("Basket B performance (%)")
    ax.set_title(f"Simulated paths at maturity\n{trade_name}")
    ax.legend(fontsize=8.5)

    ax2 = axes[1]
    sorted_diff = np.sort(diff)
    curve = np.maximum(sorted_diff, 0) if option_type == "CvC" else np.maximum(-sorted_diff, 0)
    ax2.plot(sorted_diff, curve, color=PALETTE["cac"], linewidth=2)
    ax2.axvline(0, color="grey", linewidth=0.7, linestyle=":")
    ax2.set_xlabel("R_A - R_B (%)")
    ax2.set_ylabel("Payoff (% notional)")
    ax2.set_title(f"{option_type} payoff profile")
    return _save(fig, filename)


